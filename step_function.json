{
  "Comment": "Scones Unlimited: serialize image -> classify -> filter low-confidence inferences",
  "QueryLanguage": "JSONPath",
  "StartAt": "Serialize image data",
  "States": {
    "Serialize image data": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "serializeImageData",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload.body",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Classify image"
    },
    "Classify image": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "classifyImage",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload.body",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Filter low-confidence inferences"
    },
    "Filter low-confidence inferences": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "filterLowConfidence",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload.body",
      "End": true
    }
  }
}